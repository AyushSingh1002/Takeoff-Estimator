  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.1.2",
